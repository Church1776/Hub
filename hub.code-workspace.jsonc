{
    "folders": [
        {
            "name": "Hub",
            "path": "."
        }/**///
        ,{
            "name": "Folder 2",
            "path": ""
        }/** ///
        ,{
            "name": "Folder 3",
            "path": ""
        }/** ///
        ,{
            "name": "Folder 4",
            "path": ""
        }/** ///
        ,{
            "name": "Folder 5",
            "path": ""
        }/** ///
        ,{
            "name": "Etcetera",
            "path": ""
        }//*/
    ],
    "settings": {
        "vsicons.associations.files": [
            {
                "icon": "clangd",
                "extensions": [
                    ".clangd",
                    ".clang-format",
                    ".clang-format-ignore",
                    ".clang-tidy",
                    ".clang-tidy-ignore",
                    ".clang-tidy-apply-replacements"
                ],
                "format": "svg"
            },
            {
                "icon": "json",
                "extensions": [".json"],
                "format": "svg"
            }
        ],
        "vsicons.associations.folders": [
            {
                "icon": "client",
                "extensions": ["platforms"],
                "format": "svg"
            },
            {
                "icon": "script",
                "extensions": ["scr"],
                "format": "svg"
            },
            {
                "icon": "windows",
                "extensions": ["msys"],
                "format": "svg"
            },
            {
                "icon": "theme",
                "extensions": ["colors"],
                "format": "svg"
            },
            {
                "icon": "interfaces",
                "extensions": ["aliases"],
                "format": "svg"
            },
            {
                "icon": "shared",
                "extensions": ["keybinds"],
                "format": "svg"
            },
            {
                "icon": "controller",
                "extensions": ["subprocesses"],
                "format": "svg"
            },
            {
                "icon": "cursor",
                "extensions": ["cursor"],
                "format": "svg"
            }
        ],
        "vsicons.presets.hideExplorerArrows": true,
        "files.associations": {
            ".clang-format": "yaml",
            ".clang-tidy": "yaml",
            ".clangd": "yaml",
            "*.inc": "cpp",
            "*.inl": "cpp"
        },
        "editor.semanticHighlighting.enabled": true,
        "editor.semanticTokenColorCustomizations": {
            "rules": {
                "class": "#ffef63",
                "enum": "#5fb2fa",
                "function": "#df9fff",
                "enumMember": "#b4b4b4",
                "namespace": "#ffa846",
                "struct": "#ffef63",
                "variable": "#fefefe",
                "property": "#b4b4b4",
                "parameter": "#60ffc5",
                "macro": "#df9fff",
                "method": "#df9fff"
            }
        }
    }
}