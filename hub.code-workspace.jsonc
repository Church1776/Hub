{
    "folders": [
        {
            "name": "Hub",
            "path": "."
        }/**///
        ,{
            "name": "Folder 2",
            "path": ""
        }/** ///
        ,{
            "name": "Folder 3",
            "path": ""
        }/** ///
        ,{
            "name": "Folder 4",
            "path": ""
        }/** ///
        ,{
            "name": "Folder 5",
            "path": ""
        }/** ///
        ,{
            "name": "Etcetera",
            "path": ""
        }//*/
    ],
    "settings": {
        "vsicons.associations.files": [
            {
                "icon": "clangd",
                "extensions": [
                    ".clangd",
                    ".clang-format",
                    ".clang-format-ignore",
                    ".clang-tidy",
                    ".clang-tidy-ignore",
                    ".clang-tidy-apply-replacements"
                ],
                "format": "svg"
            },
            {
                "icon": "json",
                "extensions": [".json"],
                "format": "svg"
            }
        ],
        "vsicons.associations.folders": [
            {
                "icon": "script",
                "extensions": ["scr", "script", "scripts"],
                "format": "svg"
            },
            {
                "icon": "ios",
                "extensions": ["darwin"],
                "format": "svg"
            },
            {
                "icon": "theme",
                "extensions": ["colors"],
                "format": "svg"
            },
            {
                "icon": "controller",
                "extensions": ["subprocesses"],
                "format": "svg"
            }
        ]
    }
}